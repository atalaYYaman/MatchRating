# Bu dosyayi .env olarak kopyala.
# Varsayilan: canli backend (otlak.xyz), her yerden calisir.
EXPO_PUBLIC_API_URL=https://www.otlak.xyz

# Sadece yerel backend degisikligi test edilecekse (Next.js dev server
# `npm run dev -- -H 0.0.0.0` ile calisiyorken), bilgisayarin LAN IP'sine
# cevirebilirsin. Telefon ile bilgisayar ayni Wi-Fi agina bagli olmali:
# EXPO_PUBLIC_API_URL=http://192.168.18.227:3000
