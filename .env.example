# Vercel Postgres (Storage > Postgres > .env.local sekmesinden kopyala)
POSTGRES_URL="postgres://..."
POSTGRES_URL_NON_POOLING="postgres://..."

# JWT icin rastgele uzun bir metin (openssl rand -base64 32 ile uretebilirsin)
JWT_SECRET="degistir-bu-anahtari-cok-uzun-ve-rastgele-yap"

# Yonetim panelini gorebilecek e-postalar (virgulle ayrilmis).
# Tanimli degilse panel herkese kapalidir.
ADMIN_EMAILS="sen@ornek.com"

# E-posta gonderimi (Resend). Tanimli degilse dogrulama/sifirlama
# e-postalari gonderilmez; akisin geri kalani calisir.
RESEND_API_KEY="re_..."

# --- Marka / alan adi ---
# Bunlar kodda degil ortamda: yeni domain hazir oldugunda yalnizca burasi
# degisir, yeniden dagitim disinda kod dokunulmaz.
#
# E-posta linklerinin tabani. Yeni domain hazir olunca https://panenka.tr
# yapilir; tanimli degilse https://otlak.xyz varsayilir.
NEXT_PUBLIC_APP_URL="https://panenka.tr"
# Giden e-postalarin gonderen adresi. Saglayicida DOGRULANMIS bir alan
# adi olmali; domain hazir degilse mevcut dogrulanmis adresi yaz.
MAIL_FROM="Panenka <bildirim@panenka.tr>"
# Kullanicilara gosterilen iletisim adresi.
NEXT_PUBLIC_SUPPORT_EMAIL="info@panenka.tr"
